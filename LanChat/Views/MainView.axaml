<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:LanChat.ViewModels"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="LanChat.Views.MainView"
             x:DataType="vm:MainViewModel">

    <StackPanel Spacing="15" Margin="40" VerticalAlignment="Center" MaxWidth="400">
        <!-- Header -->
        <TextBlock Text="LanChat" FontSize="28" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,20"/>

        <!-- Login input -->
        <TextBlock Text="Login:" FontWeight="SemiBold" />
        <TextBox Name="UsernameInput" PlaceholderText="Enter login..." />

        <!-- Password input -->
        <TextBlock Text="Password:" FontWeight="SemiBold" />
        <TextBox Name="PasswordInput" PlaceholderText="Enter password..." PasswordChar="•" />

        <!-- Buttons -->
        <Button Name="LoginButton" Content="Login" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Background="#0078D7" Foreground="White" Margin="0,15,0,0" Click="LoginButton_Click" />
        <Button Name="RegisterButton" Content="Register" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Click="RegisterButton_Click" />

        <!-- Error message -->
        <TextBlock Name="StatusText" Foreground="Red" HorizontalAlignment="Center" TextWrapping="Wrap" Margin="0,10,0,0"/>
    </StackPanel>

</UserControl>